[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/battle/battle.gd" id="1_battle"]

[node name="BattlePlaceholder" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_battle")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 80.0
offset_top = 80.0
offset_right = -80.0
offset_bottom = -80.0

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "⚔ 战斗"
font_size = 48
horizontal_alignment = 1

[node name="InfoLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "敌人信息"
font_size = 30
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "占位提示"
font_size = 22
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
alignment = 1

[node name="WinBtn" type="Button" parent="Margin/VBox/Buttons"]
custom_minimum_size = Vector2(320, 88)
layout_mode = 2
text = "战斗胜利（占位）"
font_size = 26

[node name="RetreatBtn" type="Button" parent="Margin/VBox/Buttons"]
custom_minimum_size = Vector2(320, 88)
layout_mode = 2
text = "撤退"
font_size = 26

[connection signal="pressed" from="Margin/VBox/Buttons/WinBtn" to="." method="_on_win_pressed"]
[connection signal="pressed" from="Margin/VBox/Buttons/RetreatBtn" to="." method="_on_retreat_pressed"]
